{
  "cards": [
    {%- assign s1 = card1_station | split: "::" -%}
    {%- assign p1 = s1[0] | split: ":" -%}
    {%- assign i1 = p1[1] | split: "+" -%}
    {
      "station": {
        "type": {{ p1[0] | json }},
        "ids": [{%- for id in i1 -%}{{ id | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}]
      },
      "routes": {{ card1_routes | json }},
      "walk": {{ card1_walk | json }},
